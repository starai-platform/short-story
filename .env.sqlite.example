# 可留空；SQLite 一键启动器会首次启动时自动生成到 .env.local。
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
ADMIN_EMAILS="admin@example.com"
# 可留空；SQLite 一键启动器会生成初始密码并保存到 .env.local。
ADMIN_PASSWORD=""
MODEL_ENCRYPTION_KEY="请替换为另一段随机字符串"

# SQLite 数据库路径由启动脚本自动设置；如需自定义可取消下一行注释。
# SQLITE_DATABASE_URL="file:./novel.sqlite"

LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4.1-mini"
LLM_MAX_OUTPUT_TOKENS="16000"
LLM_OUTLINE_MAX_OUTPUT_TOKENS="32768"
LLM_CHAPTER_MAX_CALLS="3"
